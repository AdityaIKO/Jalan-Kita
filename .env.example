# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed.

# Google Gemini API key for AI photo analysis + RAB generation.
# Get one at https://aistudio.google.com/apikey
# If left empty, the app runs in offline demo mode (deterministic heuristics).
GEMINI_API_KEY=

# Admin password for the "Admin Dinas PU" role. Change this for any real
# deployment; the demo default is only for local testing.
ADMIN_PASSWORD=
